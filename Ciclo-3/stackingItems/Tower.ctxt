comment0.target=Tower
comment0.text=\r\n\ Representa\ una\ torre\ donde\ se\ apilan\ tazas\ y\ tapas.\r\n\ Solo\ se\ encarga\ de\ agregar,\ quitar\ items\ y\ coordinar\ la\ vista.\r\n\ Las\ operaciones\ complejas\ las\ delega\ a\ TowerOperations.\r\n\ \r\n\ @author\ Daniel\r\n\ @version\ 1.0\r\n
